{
    "name": "condoedge/communications",
    "description": "A communications package for kompo/kompo",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Condoedge\\Communications\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Condoedge\\Communications\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "orchestra/testbench": "^8.0|^9.0",
        "brianium/paratest": "^7.0"
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "test": [
            "@php vendor/bin/testbench migrate",
            "@php vendor/bin/testbench package:test"
        ],
        "test-testdox": [
            "@php vendor/bin/testbench migrate",
            "@php vendor/bin/testbench package:test --testdox"
        ]
    },
    "require": {
        "php": "^8.0",
        "laravel/framework": ">=5.6.0",
        "kompo/kompo": "*",
        "kompo/auth": "^0.7.246",
        "laravel/vonage-notification-channel": "^3.3",
        "condoedge/utils": "^v0.2.12",
        "condoedge/tasks": "^0.2.11"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Condoedge\\Communications\\CondoedgeCommunicationServiceProvider"
            ]
        }
    },
    "config": {
        "audit": {
            "ignore": [
                "PKSA-3r5d-mb8f-1qw9",
                "PKSA-m5cs-t1y6-qpcs",
                "PKSA-mdq4-51ck-6kdq",
                "PKSA-zwc5-qtrz-zm1n"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
